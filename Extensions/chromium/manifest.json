{
  "manifest_version": 3,
  "name": "less for X",
  "version": "1.0.0",
  "description": "Counts the X tabs you open each day and hands them to the less Mac app, where you rate whether each was useful.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "nativeMessaging", "storage", "alarms"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "less: X today",
    "default_popup": "popup.html"
  }
}
